# Managed by ansible.
# file: {{ template_destpath }}

# All services run without a chroot so native SQL and CA paths remain available.
{% if postfix_smtp_enabled %}
smtp inet n - n - - smtpd
  -o milter_macro_daemon_name={{ 'ORIGINATING' if postfix_smtp_auth_required else 'INBOUND' }}
{% if postfix_smtp_auth_required %}
  -o smtpd_milters={{ postfix_submission_milters | join(',') }}
{% endif %}
{% endif %}
{% if postfix_submission_enabled %}
{{ postfix_submission_port }} inet n - n - - smtpd
  -o syslog_name=postfix/submission
  -o smtpd_tls_security_level=encrypt
  -o smtpd_sasl_auth_enable=yes
  -o smtpd_relay_restrictions=permit_sasl_authenticated,reject
  -o smtpd_recipient_restrictions=permit_sasl_authenticated,reject
  -o smtpd_client_restrictions=permit_sasl_authenticated,reject
  -o smtpd_sender_restrictions={{ 'reject_sender_login_mismatch' if postfix_sender_authorization else '' }}
  -o smtpd_milters={{ postfix_submission_milters | join(',') }}
{% endif %}
{% if postfix_submissions_enabled %}
{{ postfix_submissions_port }} inet n - n - - smtpd
  -o syslog_name=postfix/submissions
  -o smtpd_tls_wrappermode=yes
  -o smtpd_sasl_auth_enable=yes
  -o smtpd_relay_restrictions=permit_sasl_authenticated,reject
  -o smtpd_recipient_restrictions=permit_sasl_authenticated,reject
  -o smtpd_client_restrictions=permit_sasl_authenticated,reject
  -o smtpd_sender_restrictions={{ 'reject_sender_login_mismatch' if postfix_sender_authorization else '' }}
  -o smtpd_milters={{ postfix_submission_milters | join(',') }}
{% endif %}
{% if postfix_fetchmail_enabled %}
{{ postfix_fetchmail_address }}:{{ postfix_fetchmail_port }} inet n - n - - smtpd
  -o syslog_name=postfix/fetchmail
  -o smtpd_sasl_auth_enable={{ 'yes' if postfix_fetchmail_auth_required else 'no' }}
  -o smtpd_tls_security_level={{ 'encrypt' if postfix_fetchmail_auth_required else ('may' if postfix_tls_certificate else 'none') }}
  -o mynetworks={{ postfix_fetchmail_networks | join(',') }}
  -o smtpd_client_restrictions=permit_mynetworks,reject
  -o smtpd_relay_restrictions=reject_unauth_destination
  -o smtpd_recipient_restrictions={{ 'permit_sasl_authenticated,reject' if postfix_fetchmail_auth_required else 'reject_unlisted_recipient' }}
  -o smtpd_sender_restrictions=
  -o milter_macro_daemon_name=INBOUND
{% endif %}
pickup unix n - n 60 1 pickup
cleanup unix n - n - 0 cleanup
qmgr unix n - n 300 1 qmgr
tlsmgr unix - - n 1000? 1 tlsmgr
rewrite unix - - n - - trivial-rewrite
bounce unix - - n - 0 bounce
defer unix - - n - 0 bounce
trace unix - - n - 0 bounce
verify unix - - n - 1 verify
flush unix n - n 1000? 0 flush
proxymap unix - - n - - proxymap
proxywrite unix - - n - 1 proxymap
smtp unix - - n - - smtp
relay unix - - n - - smtp
showq unix n - n - - showq
error unix - - n - - error
retry unix - - n - - error
discard unix - - n - - discard
local unix - n n - - local
virtual unix - n n - - virtual
lmtp unix - - n - - lmtp
anvil unix - - n - 1 anvil
scache unix - - n - 1 scache
postlog unix-dgram n - n - 1 postlogd
{% for provider in postfix_providers %}
provider_{{ provider.name }} unix - - n - - smtp
  -o syslog_name=postfix/provider_{{ provider.name }}
  -o smtp_sasl_auth_enable=yes
  -o smtp_tls_security_level=secure
  -o smtp_tls_wrappermode={{ 'yes' if provider.tls | default(postfix_provider_tls) == 'wrapper' else 'no' }}
{% endfor %}
