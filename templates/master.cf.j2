{% filter postfix_unique_services %}
# Managed by ansible.
# file: /etc/postfix/master.cf

{% for service in __postfix_listeners %}
{% if service.postscreen %}
{{ service.bind }} inet n - n - 1 postscreen
  -o smtpd_service_name=screen_{{ service.name }}
  -o tlsproxy_service_name=tls_{{ service.name }}
  -o postscreen_tls_security_level={{ service.tls }}
  -o postscreen_cache_map={{ __postfix_cache_type }}:$data_directory/postscreen_cache_{{ service.name }}
{% if service.options.smtpd_discard_ehlo_keywords is defined and 'postscreen_discard_ehlo_keywords' not in service.screen_options %}
  -o { postscreen_discard_ehlo_keywords = {{ service.options.smtpd_discard_ehlo_keywords }} }
{% endif %}
{% for parameter, value in service.screen_options.items() %}
  -o { {{ parameter }} = {{ value }} }
{% endfor %}
tls_{{ service.name }} unix - - n - 0 tlsproxy
  -o smtpd_tls_security_level={{ service.tls }}
screen_{{ service.name }} pass - - n - - smtpd
{% else %}
{{ service.bind }} inet n - n - - smtpd
{% endif %}
{% for parameter, value in service.options.items() %}
  -o { {{ parameter }} = {{ value }} }
{% endfor %}
{% endfor %}
{% if __postfix_listeners | selectattr('postscreen') | length %}
dnsblog unix - - n - 0 dnsblog
{% endif %}
pickup unix n - n 60 1 pickup
cleanup unix n - n - 0 cleanup
qmgr unix n - n 300 1 qmgr
tlsmgr unix - - n 1000? 1 tlsmgr
rewrite unix - - n - - trivial-rewrite
bounce unix - - n - 0 bounce
defer unix - - n - 0 bounce
trace unix - - n - 0 bounce
verify unix - - n - 1 verify
flush unix n - n 1000? 0 flush
proxymap unix - - n - - proxymap
proxywrite unix - - n - 1 proxymap
smtp unix - - n - - {{ 'error' if postfix_outbound == 'none' else 'smtp' }}
relay unix - - n - - {{ 'error' if postfix_outbound == 'none' else 'smtp' }}
showq unix n - n - - showq
error unix - - n - - error
retry unix - - n - - error
discard unix - - n - - discard
local unix - n n - - local
virtual unix - n n - - virtual
lmtp unix - - n - - lmtp
anvil unix - - n - 1 anvil
scache unix - - n - 1 scache
postlog unix-dgram n - n - 1 postlogd
{% for provider in postfix_providers %}
provider_{{ provider.name }} unix - - n - - smtp
  -o syslog_name=postfix/provider_{{ provider.name }}
  -o smtp_sasl_auth_enable=yes
  -o smtp_tls_security_level=secure
  -o smtp_tls_wrappermode={{ 'yes' if provider.tls | default(postfix_provider_tls) == 'wrapper' else 'no' }}
{% endfor %}
{% if postfix_outbound == 'relayhost' %}
managed_relay unix - - n - - smtp
  -o smtp_sasl_auth_enable={{ 'yes' if postfix_relayhost.get('username') else 'no' }}
  -o smtp_tls_security_level={{ 'secure' if postfix_relayhost.get('tls') == 'wrapper' else postfix_relayhost.get('tls', 'secure') }}
  -o smtp_tls_wrappermode={{ 'yes' if postfix_relayhost.get('tls') == 'wrapper' else 'no' }}
{% endif %}
{% for service in postfix_master_cf %}
{{ service.name }} {{ service.type }} {{ service.private | default('-') }} {{ service.unprivileged | default('-') }} {{ service.chroot | default('n') }} {{ service.wakeup | default('-') }} {{ service.limit | default('-') }} {{ service.command }}
{% for parameter, value in (service.options | default({}) | postfix_clean_options).items() %}
  -o { {{ parameter }} = {{ value }} }
{% endfor %}
{% endfor %}
{% endfilter -%}
