{{ ansible_managed | comment(prefix_count=0, postfix_count=0) }}
# file: {{ template_destpath }}
server_host = {{ postfix_ldap.uris | join(' ') }}
version = 3
tls_require_cert = yes
tls_ca_cert_file = {{ postfix_ldap.ca_file }}
chase_referrals = no
bind = yes
bind_dn = {{ postfix_ldap.bind_dn }}
bind_pw = {{ postfix_ldap.bind_password }}
search_base = {{ postfix_ldap.base }}
{% if __postfix_alias is defined %}
{% set query = postfix_ldap_alias_queries[__postfix_alias] %}
domain = {{ __postfix_ldap_domains | join(', ') }}
query_filter = {{ query.filter }}
result_attribute = {{ query.get('result_attribute', '') }}
{% if query.special_result_attribute is defined %}
special_result_attribute = {{ query.special_result_attribute }}
{% endif %}
{% if query.leaf_result_attribute is defined %}
leaf_result_attribute = {{ query.leaf_result_attribute }}
{% endif %}
{% else %}
{% if __postfix_ldap_map.name != 'sasl_access' %}
domain = {{ __postfix_ldap_domains | join(', ') }}
{% endif %}
query_filter = (&{{ postfix_ldap.eligibility_filter }}({{ postfix_ldap[__postfix_ldap_map.key] }}=%s))
result_attribute = {{ postfix_ldap[__postfix_ldap_map.result] }}
result_format = {{ __postfix_ldap_map.format }}
{% endif %}
