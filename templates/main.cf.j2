# Managed by ansible.
# file: {{ template_destpath }}

compatibility_level = 3.6
default_database_type = {{ __postfix_table_type.stdout }}
setgid_group = {{ __postfix_setgid_group }}
myhostname = {{ postfix_hostname }}
myorigin = {{ postfix_origin }}
inet_interfaces = {{ postfix_interfaces | join(', ') }}
inet_protocols = {{ postfix_protocols }}
mydestination = {{ postfix_local_domains | join(', ') }}
mynetworks = {{ postfix_trusted_networks | join(', ') }}
relay_domains =
alias_maps = {{ __postfix_table_type.stdout }}:/etc/postfix/ansible/local_aliases
alias_database = $alias_maps
authorized_submit_users = {{ postfix_local_submitters.keys() | join(', ') }}
local_login_sender_maps = {{ __postfix_table_type.stdout }}:/etc/postfix/ansible/local_senders

smtpd_relay_restrictions = {{ 'permit_sasl_authenticated, reject' if postfix_smtp_auth_required else 'reject_unauth_destination' }}
{% if postfix_smtp_trusted_only %}
smtpd_client_restrictions = permit_mynetworks, reject
{% endif %}
{% if postfix_smtp_auth_required %}
smtpd_recipient_restrictions = permit_sasl_authenticated, reject
{% else %}
smtpd_recipient_restrictions = reject_non_fqdn_recipient, reject_unknown_recipient_domain, reject_unlisted_recipient{% for endpoint in postfix_smtp_policy_services %}, check_policy_service {{ endpoint }}{% endfor %}

{% endif %}

smtpd_helo_required = yes
disable_vrfy_command = yes
smtpd_sasl_auth_enable = {{ 'yes' if postfix_smtp_auth_required else 'no' }}
smtpd_sasl_type = dovecot
smtpd_sasl_path = {{ postfix_dovecot_auth_socket }}
smtpd_sasl_security_options = noanonymous
smtpd_tls_auth_only = yes
{% if postfix_sender_authorization %}
{% if postfix_smtp_auth_required %}
smtpd_sender_restrictions = reject_sender_login_mismatch
{% elif postfix_account_backend == 'files' %}
smtpd_sender_restrictions = reject_non_fqdn_sender, check_sender_access {{ __postfix_table_type.stdout }}:/etc/postfix/ansible/protected_senders
{% else %}
smtpd_sender_restrictions = reject_non_fqdn_sender, check_sender_access proxy:{{ postfix_account_backend }}:/etc/postfix/ansible/protected_senders.cf
{% endif %}
{% endif %}
{% if postfix_account_backend == 'files' %}
smtpd_sender_login_maps = {{ __postfix_table_type.stdout }}:/etc/postfix/ansible/senders
virtual_mailbox_maps = {{ __postfix_table_type.stdout }}:/etc/postfix/ansible/mailboxes
virtual_alias_maps = {{ __postfix_table_type.stdout }}:/etc/postfix/ansible/virtual_aliases
virtual_mailbox_domains = {{ postfix_virtual_domains | join(', ') }}
{% else %}
smtpd_sender_login_maps = proxy:{{ postfix_account_backend }}:/etc/postfix/ansible/senders.cf,
    proxy:{{ postfix_account_backend }}:/etc/postfix/ansible/alias_domain_senders.cf
virtual_mailbox_maps = proxy:{{ postfix_account_backend }}:/etc/postfix/ansible/mailboxes.cf
virtual_alias_maps = proxy:{{ postfix_account_backend }}:/etc/postfix/ansible/virtual_aliases.cf,
    proxy:{{ postfix_account_backend }}:/etc/postfix/ansible/alias_domains.cf,
    proxy:{{ postfix_account_backend }}:/etc/postfix/ansible/alias_domain_catchalls.cf
virtual_mailbox_domains = proxy:{{ postfix_account_backend }}:/etc/postfix/ansible/domains.cf
{% endif %}
virtual_alias_domains =
virtual_transport = {{ postfix_dovecot_lmtp_transport }}
{% if postfix_local_lmtp_enabled %}
mailbox_transport = {{ postfix_dovecot_lmtp_transport }}
{% endif %}
recipient_delimiter = +
transport_maps = {{ __postfix_table_type.stdout }}:/etc/postfix/ansible/transport
sender_bcc_maps = {{ __postfix_table_type.stdout }}:/etc/postfix/ansible/sender_bcc
recipient_bcc_maps = {{ __postfix_table_type.stdout }}:/etc/postfix/ansible/recipient_bcc

sender_dependent_relayhost_maps = {{ __postfix_table_type.stdout }}:/etc/postfix/ansible/sender_relay
sender_dependent_default_transport_maps = {{ __postfix_table_type.stdout }}:/etc/postfix/ansible/sender_transport
{% if postfix_default_provider %}
{% for provider in postfix_providers if provider.name == postfix_default_provider %}
relayhost = [{{ provider.host }}]:{{ provider.port | default(postfix_provider_port) }}
default_transport = provider_{{ provider.name }}
{% endfor %}
{% else %}
relayhost =
default_transport = smtp
{% endif %}
smtp_sender_dependent_authentication = yes
smtp_sasl_auth_enable = no
smtp_sasl_password_maps = {{ __postfix_table_type.stdout }}:/etc/postfix/ansible/sasl_passwd
smtp_sasl_security_options = noanonymous
smtp_sasl_tls_security_options = noanonymous
smtp_tls_security_level = may
smtp_tls_policy_maps = {{ __postfix_table_type.stdout }}:/etc/postfix/ansible/tls_policy
smtp_tls_CAfile = {{ postfix_tls_ca_file or __postfix_ca_file }}
smtp_tls_mandatory_protocols = >=TLSv1.2
smtp_tls_loglevel = {{ postfix_tls_loglevel }}
{% if postfix_tls_certificate %}
smtpd_tls_cert_file = {{ postfix_tls_certificate }}
smtpd_tls_key_file = {{ postfix_tls_private_key }}
smtpd_tls_security_level = {{ 'encrypt' if postfix_smtp_auth_required else 'may' }}
{% else %}
smtpd_tls_security_level = none
{% endif %}
smtpd_tls_mandatory_protocols = >=TLSv1.2
smtpd_tls_loglevel = {{ postfix_tls_loglevel }}

message_size_limit = {{ postfix_message_size_limit }}
mailbox_size_limit = 0
maximal_queue_lifetime = {{ postfix_maximal_queue_lifetime }}
bounce_queue_lifetime = {{ postfix_bounce_queue_lifetime }}
minimal_backoff_time = {{ postfix_minimal_backoff_time }}
maximal_backoff_time = {{ postfix_maximal_backoff_time }}
queue_run_delay = {{ postfix_queue_run_delay }}
maillog_file = {{ postfix_log_file }}

milter_protocol = 6
milter_default_action = {{ postfix_milter_default_action }}
smtpd_milters = {{ postfix_smtpd_milters | join(', ') }}
non_smtpd_milters = {{ postfix_non_smtpd_milters | join(', ') }}
milter_macro_daemon_name = ORIGINATING
