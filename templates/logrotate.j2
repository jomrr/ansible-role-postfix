{{ ansible_managed | comment(prefix_count=0, postfix_count=0) }}
# file: {{ template_destpath }}
{{ postfix_log_file | to_json }} {
    {{ postfix_logrotate_interval }}
    rotate {{ postfix_logrotate_count }}
    missingok
    notifempty
    compress
    delaycompress
    create 0600 root root
    postrotate
        /usr/sbin/postfix reload
    endscript
}
